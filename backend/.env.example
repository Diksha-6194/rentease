# Django Secret Key (Generate a secure random string for production)
SECRET_KEY=your_secure_secret_key_here

# Debug Mode (Must be False in production)
DEBUG=False

# Allowed Hosts (Comma separated domains, e.g., api.rentease.com)
ALLOWED_HOSTS=api.rentease.com

# CORS Allowed Origins (Comma separated domains, e.g., https://rentease.com)
CORS_ALLOWED_ORIGINS=https://rentease.com

# PostgreSQL Database URL
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Cloudinary Storage URL
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
